# Copie para .env e ajuste.
DATABASE_URL=postgresql://mesa:troque-esta-senha@localhost:5432/mesa

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SEGREDO_JWT=

# Validade do login, em minutos.
JWT_MINUTOS=60

# Endereço público usado nos links de convite e nos QR codes.
URL_PUBLICA=http://localhost:8000

# Só para os testes (pytest): um banco descartável, que é apagado a cada execução.
TEST_DATABASE_URL=postgresql://mesa:troque-esta-senha@localhost:5432/mesa_teste
